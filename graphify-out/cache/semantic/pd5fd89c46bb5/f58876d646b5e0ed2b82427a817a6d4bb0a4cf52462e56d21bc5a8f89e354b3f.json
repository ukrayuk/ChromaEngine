{"nodes": [{"id": "pigment_ancestry_model_readme_pigment_ancestry_model", "label": "Pigment Ancestry Model (Colour Family Arc System)", "file_type": "concept", "source_file": "pigment-ancestry-model/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pigment_ancestry_model_readme_level_1_arcs", "label": "Level 1 arcs (dyadic recursive-midpoint subdivision)", "file_type": "concept", "source_file": "pigment-ancestry-model/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pigment_ancestry_model_readme_level_2", "label": "Level 2 (cross-arc mixing)", "file_type": "concept", "source_file": "pigment-ancestry-model/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pigment_ancestry_model_readme_level_3", "label": "Level 3 (three-way cross-arc mixing)", "file_type": "concept", "source_file": "pigment-ancestry-model/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pigment_ancestry_model_readme_roy_arc", "label": "RoY arc (Red-Yellow -> Orange)", "file_type": "concept", "source_file": "pigment-ancestry-model/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pigment_ancestry_model_readme_ygb_arc", "label": "YgB arc (Yellow-Blue -> Green)", "file_type": "concept", "source_file": "pigment-ancestry-model/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pigment_ancestry_model_readme_bvr_arc", "label": "BvR arc (Blue-Red -> Violet)", "file_type": "concept", "source_file": "pigment-ancestry-model/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pigment_ancestry_model_readme_dyadic_subdivision", "label": "Dyadic recursive-midpoint subdivision (8 generations, 257 points/arc)", "file_type": "concept", "source_file": "pigment-ancestry-model/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pigment_ancestry_model_readme_spectraljs", "label": "spectral.js (Kubelka-Munk pigment mixing library, v3.0)", "file_type": "code", "source_file": "pigment-ancestry-model/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen over RGB blending to mix as real pigments do (Kubelka-Munk), not flat colour averaging; v3.0 Color-class API used deliberately, not the old 2.0.2 flat-hex-string API."}, {"id": "pigment_ancestry_model_readme_delta_e_threshold", "label": "\u0394E \u2264 15.3 fit threshold (CIE76, D65)", "file_type": "rationale", "source_file": "pigment-ancestry-model/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raised from 14 to 15.3 at anchor sign-off; chosen as the one threshold used everywhere afterward for consistency, despite known CIE76 non-uniformity (same \u0394E is a bigger perceptual shift on low-chroma colours than high-chroma ones)."}, {"id": "pigment_ancestry_model_readme_canonical_anchors", "label": "Six canonical hue-role anchors (Warm Red, Warm Yellow, Cool Yellow, Cool Blue, Warm Blue, Cool Red)", "file_type": "concept", "source_file": "pigment-ancestry-model/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RoY/YgB anchors use real measured pencils because they score better that way; BvR uses synthetic Munsell-derived anchors because BvR's coverage jumps substantially on synthetic anchors while RoY/YgB do best on real ones -- chosen per-arc by comparing all-real vs all-synthetic vs mixed against book-scope classification coverage."}, {"id": "pigment_ancestry_model_readme_arc1_aligned_dropped", "label": "Level 3 \"Arc1 \u2014 aligned\" dropped", "file_type": "rationale", "source_file": "pigment-ancestry-model/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every Level 1 arc pairs a warm anchor from one family with a cool anchor from another, so the 'aligned' (no-flip) three-way combination always mixes warm+cool and never settles toward a clean warm or cool result -- permanently medium-muted (chroma 28.7, range 22.2-41.0 vs 0.4-70.3 for the three flipped arcs). Rescued zero book-scope pencils before being dropped; verified the drop changes coverage not at all (771/1150, 846/1294, identical)."}, {"id": "pigment_ancestry_model_readme_bvr_six_sector_split", "label": "BvR six-sector split (abandoned)", "file_type": "rationale", "source_file": "pigment-ancestry-model/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Splitting BvR into Blue-Violet + Violet-Red sub-arcs bridged by a shared midpoint looked better on a narrow pool-count metric (1796/1825 vs 1781/1825) but was visually wrong -- the new sub-arcs produced muddy, desaturated colour exactly at the seam, only visible in a rendered swatch, not caught by the metric. Abandoned in favour of a single synthetic BvR arc. Lesson: a fit-count metric can pass while the actual colour is wrong -- always confirm with a rendered swatch/diagram."}, {"id": "pigment_ancestry_model_readme_warm_yellow_corrections", "label": "Warm Yellow anchor corrections (two rounds)", "file_type": "rationale", "source_file": "pigment-ancestry-model/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Started as Yellow Ochre (#f7c81e), chosen hue-precision-first; a systematic cross-brand gap (every pencil range missing a vivid 'Cadmium Yellow'-type pencil near the model's position) led to swapping to Lemon (#ffd200) 2026-10-04, then correcting a slipped hex to #ffd800 (Medium Cadmium Yellow Imit.) 2026-10-09, confirmed by Ray's own by-eye audit both times."}, {"id": "pigment_ancestry_model_readme_cool_yellow_correction", "label": "Cool Yellow anchor correction (2026-10-15)", "file_type": "rationale", "source_file": "pigment-ancestry-model/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Previous anchor #f6e83b read too warm/close to Warm Yellow by eye. A numbers-led first pass (4 candidates ranked by coverage cost) was rejected by Ray after testing real swatches against a live arc rendering -- 'none look right on the arc'. An eye-led second pass found Cadmium Yellow Lemon #e7ed46 (H=105.7\u00b0), confirmed by eye AND a genuine coverage gain (+11 book/+14 combined), unlike every earlier candidate which all cost coverage -- the only anchor change so far that didn't trade accuracy for appearance."}, {"id": "pigment_ancestry_model_readme_lib_cjs", "label": "lib.cjs (core colour math module)", "file_type": "code", "source_file": "pigment-ancestry-model/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pigment_ancestry_model_readme_hextolabd65", "label": "hexToLabD65()", "file_type": "code", "source_file": "pigment-ancestry-model/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Computes Lab always as D65 2\u00b0 (Xn=0.95047 Yn=1.0 Zn=1.08883), not the master.json lab_d50_2 field directly, for consistency across the project."}, {"id": "pigment_ancestry_model_readme_mixspectral", "label": "mixSpectral() (50:50 dyadic mixing step)", "file_type": "code", "source_file": "pigment-ancestry-model/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pigment_ancestry_model_readme_mixn", "label": "mixN() (equal-N mix)", "file_type": "code", "source_file": "pigment-ancestry-model/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pigment_ancestry_model_readme_mixtrueshare", "label": "mixTrueShare()/mixTrueEqual()", "file_type": "code", "source_file": "pigment-ancestry-model/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Solves for the mixing factors that give a TRUE concentration share, since spectral.js weights by factor^2 x tintingStrength^2 x luminance, not by the raw factor -- a naive equal-factor mix would not represent an equal pigment share."}, {"id": "pigment_ancestry_model_readme_labdist", "label": "labDist() (CIE76 \u0394E)", "file_type": "code", "source_file": "pigment-ancestry-model/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pigment_ancestry_model_readme_gen_level1_pure_rows", "label": "scripts/gen_level1_pure_rows.cjs", "file_type": "code", "source_file": "pigment-ancestry-model/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pigment_ancestry_model_readme_gen_level2_cross_rows", "label": "scripts/gen_level2_cross_rows.cjs", "file_type": "code", "source_file": "pigment-ancestry-model/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pigment_ancestry_model_readme_gen_level3_cross_rows", "label": "scripts/gen_level3_cross_rows.cjs", "file_type": "code", "source_file": "pigment-ancestry-model/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pigment_ancestry_model_readme_classify_coverage", "label": "scripts/classify_coverage.cjs", "file_type": "code", "source_file": "pigment-ancestry-model/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pigment_ancestry_model_readme_build_level1_level2_combo_v2", "label": "scripts/diagrams/build_level1_level2_combo_v2.cjs", "file_type": "code", "source_file": "pigment-ancestry-model/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pigment_ancestry_model_readme_master_json", "label": "master.json (measured pencil database, 1825 pencils)", "file_type": "document", "source_file": "pigment-ancestry-model/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pigment_ancestry_model_readme_never_fit_final_153", "label": "data/never_fit_final_153.json (pool/never-fit list)", "file_type": "document", "source_file": "pigment-ancestry-model/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pigment_ancestry_model_readme_never_fit_taxonomy", "label": "Never-fit taxonomy (tint/tone/shade/neutral/etc.)", "file_type": "concept", "source_file": "pigment-ancestry-model/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Classifies pencils that don't fit Level 1/2/3 by which Lab axis dominates the gap to the nearest model point (tint/shade/tone/neutral/high-neon/hue-gap), after first pulling out neutrals via Munsell chroma bands (not Lab chroma, which is unreliable both ways). Mirrors the book's own Ch5 tint/tone/shade structure deliberately."}, {"id": "pigment_ancestry_model_readme_level2_rescue_method", "label": "Level 2 cross-arc \"rescue\" method", "file_type": "rationale", "source_file": "pigment-ancestry-model/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A muted/earthy target that doesn't fit a pure Level 1 arc often fits a Level 2 cross-arc mix (e.g. green x violet) instead -- blending with an adjacent-family arc at the same t/generation knocks chroma and value down together. Recommended as the first thing to check before reaching for any kind of dechroma transform."}, {"id": "pigment_ancestry_model_readme_olive_dechroma_dead_end", "label": "Olive/dechroma dead end (Chapter 5 pre-thinking)", "file_type": "rationale", "source_file": "pigment-ancestry-model/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A pure value-held chroma reduction from a Level 1 arc point cannot reach a muted target like Olive because the YgB arc's hue and lightness are coupled (hue rotates toward blue-green as lightness drops) -- the nearest-hue arc point sits at the wrong lightness entirely. Resolved by using the Level 2 cross-arc rescue method instead."}, {"id": "pigment_ancestry_model_readme_p3_srgb_gamut_investigation", "label": "P3-vs-sRGB gamut investigation (flagged, not actioned)", "file_type": "rationale", "source_file": "pigment-ancestry-model/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "18.3% of 1825 pencils are sRGB-clipped (70.7% of those rescued under P3); several of the model's own anchors are themselves measurably chroma-clipped by the sRGB pipeline (e.g. the Lemon anchor loses ~13.7 points of true chroma via the sRGB round-trip) -- a legitimate future investigation, anchors remain locked on sRGB-derived hex throughout for now."}], "edges": [{"source": "pigment_ancestry_model_readme_pigment_ancestry_model", "target": "pigment_ancestry_model_readme_level_1_arcs", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "pigment-ancestry-model/README.md", "source_location": null, "weight": 1.0}, {"source": "pigment_ancestry_model_readme_pigment_ancestry_model", "target": "pigment_ancestry_model_readme_level_2", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "pigment-ancestry-model/README.md", "source_location": null, "weight": 1.0}, {"source": "pigment_ancestry_model_readme_pigment_ancestry_model", "target": "pigment_ancestry_model_readme_level_3", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "pigment-ancestry-model/README.md", "source_location": null, "weight": 1.0}, {"source": "pigment_ancestry_model_readme_level_1_arcs", "target": "pigment_ancestry_model_readme_roy_arc", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "pigment-ancestry-model/README.md", "source_location": null, "weight": 1.0}, {"source": "pigment_ancestry_model_readme_level_1_arcs", "target": "pigment_ancestry_model_readme_ygb_arc", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "pigment-ancestry-model/README.md", "source_location": null, "weight": 1.0}, {"source": "pigment_ancestry_model_readme_level_1_arcs", "target": "pigment_ancestry_model_readme_bvr_arc", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "pigment-ancestry-model/README.md", "source_location": null, "weight": 1.0}, {"source": "pigment_ancestry_model_readme_level_1_arcs", "target": "pigment_ancestry_model_readme_dyadic_subdivision", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "pigment-ancestry-model/README.md", "source_location": null, "weight": 1.0}, {"source": "pigment_ancestry_model_readme_dyadic_subdivision", "target": "pigment_ancestry_model_readme_spectraljs", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "pigment-ancestry-model/README.md", "source_location": null, "weight": 1.0}, {"so