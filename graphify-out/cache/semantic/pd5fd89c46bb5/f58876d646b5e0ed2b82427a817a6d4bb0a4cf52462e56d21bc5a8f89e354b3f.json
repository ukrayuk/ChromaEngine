ce_file": "pigment-ancestry-model/README.md", "source_location": null, "weight": 1.0}, {"source": "pigment_ancestry_model_readme_lib_cjs", "target": "pigment_ancestry_model_readme_hextolabd65", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "pigment-ancestry-model/README.md", "source_location": null, "weight": 1.0}, {"source": "pigment_ancestry_model_readme_lib_cjs", "target": "pigment_ancestry_model_readme_mixspectral", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "pigment-ancestry-model/README.md", "source_location": null, "weight": 1.0}, {"source": "pigment_ancestry_model_readme_lib_cjs", "target": "pigment_ancestry_model_readme_mixn", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "pigment-ancestry-model/README.md", "source_location": null, "weight": 1.0}, {"source": "pigment_ancestry_model_readme_lib_cjs", "target": "pigment_ancestry_model_readme_mixtrueshare", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "pigment-ancestry-model/README.md", "source_location": null, "weight": 1.0}, {"source": "pigment_ancestry_model_readme_lib_cjs", "target": "pigment_ancestry_model_readme_labdist", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "pigment-ancestry-model/README.md", "source_location": null, "weight": 1.0}, {"source": "pigment_ancestry_model_readme_gen_level1_pure_rows", "target": "pigment_ancestry_model_readme_gen_level2_cross_rows", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "pigment-ancestry-model/README.md", "source_location": null, "weight": 1.0}, {"source": "pigment_ancestry_model_readme_gen_level2_cross_rows", "target": "pigment_ancestry_model_readme_gen_level3_cross_rows", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "pigment-ancestry-model/README.md", "source_location": null, "weight": 1.0}, {"source": "pigment_ancestry_model_readme_gen_level3_cross_rows", "target": "pigment_ancestry_model_readme_classify_coverage", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "pigment-ancestry-model/README.md", "source_location": null, "weight": 1.0}, {"source": "pigment_ancestry_model_readme_classify_coverage", "target": "pigment_ancestry_model_readme_master_json", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "pigment-ancestry-model/README.md", "source_location": null, "weight": 1.0}, {"source": "pigment_ancestry_model_readme_classify_coverage", "target": "pigment_ancestry_model_readme_never_fit_taxonomy", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "pigment-ancestry-model/README.md", "source_location": null, "weight": 1.0}, {"source": "pigment_ancestry_model_readme_never_fit_taxonomy", "target": "pigment_ancestry_model_readme_never_fit_final_153", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "pigment-ancestry-model/README.md", "source_location": null, "weight": 1.0}, {"source": "pigment_ancestry_model_readme_build_level1_level2_combo_v2", "target": "pigment_ancestry_model_scripts_diagrams_rendering_family1", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "pigment-ancestry-model/README.md", "source_location": null, "weight": 1.0}, {"source": "pigment_ancestry_model_readme_master_json", "target": "data_readme_master_json", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "pigment-ancestry-model/README.md", "source_location": null, "weight": 1.0}, {"source": "pigment_ancestry_model_readme_level2_rescue_method", "target": "pigment_ancestry_model_readme_olive_dechroma_dead_end", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "pigment-ancestry-model/README.md", "source_location": null, "weight": 1.0}, {"source": "pigment_ancestry_model_readme_pigment_ancestry_model", "target": "pigment_ancestry_model_readme_p3_srgb_gamut_investigation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "pigment-ancestry-model/README.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "metric_vs_rendered_colour_lesson", "label": "\"Trust the rendered swatch, not just the metric\" lesson", "nodes": ["pigment_ancestry_model_readme_bvr_six_sector_split", "pigment_ancestry_model_readme_cool_yellow_correction", "pigment_ancestry_model_readme_warm_yellow_corrections"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "pigment-ancestry-model/README.md"}]}